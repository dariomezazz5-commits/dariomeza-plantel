{
  "name": "Plantel (Rails 8)",
  "image": "mcr.microsoft.com/devcontainers/ruby:1-3.3-bookworm",
  "containerEnv": {
    "RBENV_VERSION": "system"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Plantel", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bundle install && bin/rails db:prepare db:seed",
  "postAttachCommand": "bin/rails server -b 0.0.0.0",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
