<!DOCTYPE html>
<html lang="es-CL">
  <head>
    <title><%= content_for(:title) || "Plantel · Gestión de personas" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Plantel">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600&family=Barlow:wght@400;500;600&display=swap">

    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% u = usuario_actual %>
    <div class="app-shell">
      <aside class="sidebar">
        <div class="brand">
          <div class="brand-name">Plantel</div>
          <div class="brand-sub"><%= u.empresa.nombre %></div>
        </div>
        <nav class="nav">
          <% unless u.colaborador? %>
            <%= nav_item "Inicio", root_path, :house, activo: controller_name == "inicio" %>
            <%= nav_item (u.jefatura? ? "Mi equipo" : "Colaboradores"), colaboradores_path, :users, activo: %w[colaboradores importaciones].include?(controller_name) %>
          <% end %>
          <%= nav_item (u.colaborador? ? "Mis ausencias" : "Ausencias"), ausencias_path, :calendar, activo: controller_name == "solicitudes" do %>
            <% if pendientes_count > 0 %><span class="nav-badge"><%= pendientes_count %></span><% end %>
          <% end %>
          <% if u.colaborador %>
            <%= link_to colaborador_path(u.colaborador), class: "nav-item", data: { turbo_frame: "drawer" } do %>
              <%= icono :id_card %><span class="nav-label">Mi ficha</span>
            <% end %>
          <% end %>
          <% if u.admin? %>
            <%= nav_item "Auditoría", auditoria_path, :list, activo: controller_name == "auditoria" %>
          <% end %>
        </nav>
        <div class="sidebar-user">
          <%= link_to cuenta_path, class: "sidebar-user-link", title: "Mi cuenta" do %>
            <span class="avatar avatar-user"><%= u.iniciales %></span>
            <span class="sidebar-user-text">
              <span><%= u.nombre %></span>
              <span class="muted-accent"><%= u.cargo %></span>
            </span>
          <% end %>
          <%= button_to session_path, method: :delete, class: "btn-logout", title: "Cerrar sesión", "aria-label": "Cerrar sesión", form_class: "inline-form" do %>
            <%= icono :logout %>
          <% end %>
        </div>
      </aside>

      <main class="main">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    </div>

    <%# Ficha lateral de colaborador: los enlaces con data-turbo-frame="drawer" cargan colaboradores#show aquí. %>
    <%= turbo_frame_tag "drawer" do %>
      <%= render "colaboradores/ficha", colaborador: @ficha if @ficha %>
    <% end %>
  </body>
</html>
