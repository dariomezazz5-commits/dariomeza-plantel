<h1 class="auth-title">Recuperar contraseña</h1>
<p class="auth-text">Escribe tu correo y te enviaremos un enlace para elegir una nueva contraseña.</p>
<%= form_with url: passwords_path, class: "form-stack" do |form| %>
  <div class="field">
    <%= form.label :email_address, "Correo" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
  </div>
  <%= form.submit "Enviar enlace", class: "btn btn-primary btn-block" %>
<% end %>
<%= link_to "Volver a ingresar", new_session_path, class: "auth-link" %>
