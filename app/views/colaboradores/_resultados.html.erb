<div id="colaboradores_resultados">
  <% if @colaboradores.empty? %>
    <p class="empty">Ningún colaborador coincide con la búsqueda.</p>
  <% else %>
    <div class="table-scroll">
      <table class="table" style="min-width: 760px">
        <thead>
          <tr><th>Nombre</th><th>Cargo</th><th>Área</th><th>Sede</th><th>Ingreso</th><th>Estado</th></tr>
        </thead>
        <tbody>
          <% @colaboradores.each do |c| %>
            <tr class="row-link" data-controller="fila" data-action="click->fila#abrir">
              <td>
                <%= link_to colaborador_path(c), class: "person-cell", data: { turbo_frame: "drawer", fila_target: "link" } do %>
                  <%= avatar c.iniciales, size: 30 %>
                  <span class="two-line">
                    <span class="name"><%= c.nombre %></span>
                    <span class="meta"><%= c.rut %></span>
                  </span>
                <% end %>
              </td>
              <td><%= c.cargo %></td>
              <td><%= c.area %></td>
              <td><%= c.sede %></td>
              <td class="nowrap"><%= fecha_corta(c.ingreso) %></td>
              <td><span class="<%= estado_colaborador_class(c.estado) %>"><%= c.estado %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
