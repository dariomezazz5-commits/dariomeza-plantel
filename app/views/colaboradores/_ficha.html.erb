<% c = colaborador %>
  <div class="drawer" data-controller="overlay" data-action="keydown.esc@window->overlay#close">
    <div class="drawer-backdrop" data-action="click->overlay#close"></div>
    <aside class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="ficha-nombre">
      <div class="drawer-head">
        <div class="drawer-id">
          <%= avatar c.iniciales, size: 56 %>
          <div class="two-line">
            <h3 id="ficha-nombre"><%= c.nombre %></h3>
            <span class="drawer-cargo"><%= c.cargo %></span>
          </div>
        </div>
        <div class="drawer-tools">
          <% if usuario_actual.admin? %>
            <%= link_to edit_colaborador_path(c), class: "btn btn-icon", title: "Editar", "aria-label": "Editar ficha", data: { turbo_frame: "_top" } do %><%= icono :pencil %><% end %>
          <% end %>
          <button type="button" class="btn btn-icon" aria-label="Cerrar" data-action="overlay#close" data-overlay-target="focus"><%= icono :x %></button>
        </div>
      </div>

      <div class="tags">
        <span class="<%= estado_colaborador_class(c.estado) %>"><%= c.estado %></span>
        <span class="tag tag-neutral"><%= c.contrato %></span>
        <span class="tag tag-neutral"><%= c.area %></span>
      </div>

      <div class="blueprint stat-strip">
        <%= esquinas %>
        <div class="stat">
          <span class="stat-label">Saldo de vacaciones</span>
          <span class="stat-value"><%= c.saldo_vacaciones %> días</span>
        </div>
        <div class="stat">
          <span class="stat-label">Antigüedad</span>
          <span class="stat-value"><%= c.antiguedad %></span>
        </div>
      </div>

      <section class="drawer-section">
        <h6>Datos</h6>
        <% datos = [ [ "RUT", c.rut ], [ "Correo", c.email ], [ "Sede", c.sede ], [ "Área", c.area ],
                     [ "Jefatura", c.jefatura ], [ "Contrato", c.contrato ], [ "Fecha de ingreso", fecha_corta(c.ingreso) ] ] %>
        <% datos << [ "Acceso a Plantel", c.user ? c.user.rol_legible : "Sin acceso" ] if usuario_actual.admin? %>
        <% datos.each do |k, v| %>
          <div class="kv"><span class="k"><%= k %></span><span class="v"><%= v %></span></div>
        <% end %>
      </section>

      <section class="drawer-section">
        <h6>Solicitudes de ausencia</h6>
        <% if c.solicitudes.empty? %>
          <p class="empty">Sin solicitudes registradas.</p>
        <% end %>
        <% c.solicitudes.each do |s| %>
          <div class="kv-req">
            <span><%= s.tipo %> · <%= rango_fechas(s.desde, s.hasta) %></span>
            <span class="<%= estado_solicitud_class(s.estado) %>"><%= s.estado %></span>
          </div>
        <% end %>
      </section>
    </aside>
  </div>
